{
  "manifest_version": 3,
  "name": "mirigana",
  "version": "2.0.2",
  "default_locale": "en",

  "description": "__MSG_extension_description__",

  "icons": {
    "16": "icons/action-icon-16.png",
    "48": "icons/app-icon-48.png",
    "64": "icons/app-icon-64.png",
    "128": "icons/app-icon-128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_icon": {
      "16": "icons/action-icon-16.png",
      "48": "icons/action-icon-48.png",
      "64": "icons/action-icon-64.png",
      "128": "icons/action-icon-128.png"
    },
    "default_popup": "components/popup/popup.html"
  },

  "options_ui": {
    "page": "components/options/options.html",
    "open_in_tab": false
  },

  "content_scripts": [{
    "matches": [
      "*://*/*"
    ],
    "js": [
      "constants.js",
      "common-utils.js",
      "vendors/Readability.js",
      "vendors/JSDOMParser.js",
      "content_scripts/utils.js",
      "content_scripts/console.js",
      "content_scripts/miri.js",
      "content_scripts/sites/common.js"
    ]
  }, {
    "matches": [
      "https://x.com/*",
      "https://twitter.com/*"
    ],
    "js": [
      "content_scripts/sites/twitter.js"
    ]
  }],

  "permissions": [
    "storage"
  ]
}
